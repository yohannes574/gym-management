MONGO_URI=mongodb://127.0.0.1:27017/gym-platform
PORT=5000

SERVER_URL=http://localhost:5000
# Multiple browser origins can be comma-separated.
CLIENT_URL=http://localhost:5173

JWT_SECRET=replace-with-a-long-random-secret
STAFF_ACCESS_CODE=replace-with-a-random-code
SEED_OWNER_NAME=Gym Owner
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=replace-before-seeding

CHAPA_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional integration tests need a dedicated replica-set database whose name contains "test".
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/gym-platform-test?replicaSet=rs0